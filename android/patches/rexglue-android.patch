diff --git a/src/core/android_runtime.cpp b/src/core/android_runtime.cpp
new file mode 100644
index 0000000..3de9ff7
--- /dev/null
+++ b/src/core/android_runtime.cpp
@@ -0,0 +1,273 @@
+/**
+ ******************************************************************************
+ * ReXGlue : Xbox 360 Recompilation SDK
+ ******************************************************************************
+ * Android runtime glue: API level query, JNI context plumbing, ContentResolver
+ * descriptor bridge, and the AndroidInitialize/Shutdown hooks declared by the
+ * filesystem, memory and thread subsystems.
+ *
+ * The host application calls rex::SetAndroidApplicationContext() from its JNI
+ * entry point before any runtime subsystem starts, then calls
+ * rex::InitializeAndroidSystemForApplicationContext() once.
+ ******************************************************************************
+ * @added      Project 1944 Android port, 2026
+ */
+
+#include <rex/main_android.h>
+
+#if REX_PLATFORM_ANDROID
+
+#include <jni.h>
+
+#include <atomic>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <sys/system_properties.h>
+
+#include <rex/assert.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/memory/utils.h>
+#include <rex/system.h>
+#include <rex/thread.h>
+
+namespace rex {
+
+namespace {
+
+std::mutex g_context_mutex;
+JavaVM* g_java_vm = nullptr;
+jobject g_activity = nullptr;       // global ref
+jclass g_activity_class = nullptr;  // global ref
+jmethodID g_open_content_fd = nullptr;
+jclass g_pfd_class = nullptr;  // global ref
+jmethodID g_detach_fd = nullptr;
+std::filesystem::path g_native_library_dir;
+std::atomic<bool> g_context_ready{false};
+
+JNIEnv* GetThreadEnv() {
+  if (!g_java_vm) {
+    return nullptr;
+  }
+  JNIEnv* env = nullptr;
+  if (g_java_vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_1_6) == JNI_OK) {
+    return env;
+  }
+  // Runtime threads are plain pthreads; attach them on first use. bionic
+  // detaches them automatically when the thread exits.
+  if (g_java_vm->AttachCurrentThread(&env, nullptr) == JNI_OK) {
+    return env;
+  }
+  return nullptr;
+}
+
+void ClearJavaException(JNIEnv* env, const char* where) {
+  if (env->ExceptionCheck()) {
+    REXLOG_ERROR("android_runtime: Java exception in {}", where);
+    env->ExceptionDescribe();
+    env->ExceptionClear();
+  }
+}
+
+bool ResolveJavaBridges(JNIEnv* env, jobject activity) {
+  jclass local_class = env->GetObjectClass(activity);
+  if (!local_class) {
+    REXLOG_ERROR("android_runtime: GetObjectClass(activity) failed");
+    return false;
+  }
+  g_activity_class = static_cast<jclass>(env->NewGlobalRef(local_class));
+  env->DeleteLocalRef(local_class);
+  if (!g_activity_class) {
+    return false;
+  }
+
+  g_open_content_fd = env->GetStaticMethodID(
+      g_activity_class, "openContentFd",
+      "(Ljava/lang/String;Ljava/lang/String;)Landroid/os/ParcelFileDescriptor;");
+  if (!g_open_content_fd) {
+    ClearJavaException(env, "GetStaticMethodID(openContentFd)");
+    return false;
+  }
+
+  jclass local_pfd = env->FindClass("android/os/ParcelFileDescriptor");
+  if (!local_pfd) {
+    ClearJavaException(env, "FindClass(ParcelFileDescriptor)");
+    return false;
+  }
+  g_pfd_class = static_cast<jclass>(env->NewGlobalRef(local_pfd));
+  env->DeleteLocalRef(local_pfd);
+  if (!g_pfd_class) {
+    return false;
+  }
+
+  g_detach_fd = env->GetMethodID(g_pfd_class, "detachFd", "()I");
+  if (!g_detach_fd) {
+    ClearJavaException(env, "GetMethodID(detachFd)");
+    return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+uint32_t GetAndroidApiLevel() {
+  static const uint32_t api_level = [] {
+    char value[16] = {0};
+    uint32_t level = 0;
+    if (__system_property_get("ro.build.version.sdk", value) > 0) {
+      level = static_cast<uint32_t>(std::strtoul(value, nullptr, 10));
+    }
+    if (level < static_cast<uint32_t>(__ANDROID_API__)) {
+      level = static_cast<uint32_t>(__ANDROID_API__);
+    }
+    return level;
+  }();
+  return api_level;
+}
+
+void SetAndroidApplicationContext(void* java_vm, void* android_context,
+                                  const char* native_library_dir) {
+  std::lock_guard<std::mutex> lock(g_context_mutex);
+  assert_not_null(java_vm);
+  g_java_vm = static_cast<JavaVM*>(java_vm);
+
+  // Plugin loading and asset lookups run before any Java call, so record the
+  // library directory even when no activity is supplied.
+  if (native_library_dir && *native_library_dir) {
+    g_native_library_dir = std::filesystem::path(native_library_dir);
+  }
+
+  JNIEnv* env = GetThreadEnv();
+  if (!env) {
+    REXLOG_ERROR("android_runtime: no JNI env while setting the app context");
+    return;
+  }
+
+  if (!android_context) {
+    REXLOG_INFO("android_runtime: no activity context (headless), lib dir {}",
+                g_native_library_dir.string());
+    return;
+  }
+
+  if (g_activity) {
+    env->DeleteGlobalRef(g_activity);
+    g_activity = nullptr;
+  }
+  g_activity = env->NewGlobalRef(static_cast<jobject>(android_context));
+  if (!g_activity) {
+    REXLOG_ERROR("android_runtime: NewGlobalRef(activity) failed");
+    return;
+  }
+
+  if (!ResolveJavaBridges(env, g_activity)) {
+    REXLOG_ERROR("android_runtime: failed to resolve Java bridges");
+    return;
+  }
+
+  g_context_ready.store(true, std::memory_order_release);
+  REXLOG_INFO("android_runtime: context ready (api {}, lib dir {})", GetAndroidApiLevel(),
+              g_native_library_dir.string());
+}
+
+const std::filesystem::path& GetAndroidNativeLibraryDir() {
+  return g_native_library_dir;
+}
+
+int OpenContentUriFdJavaBridge(const std::string_view uri, const char* mode) {
+  JNIEnv* env = GetThreadEnv();
+  if (!env || !g_context_ready.load(std::memory_order_acquire)) {
+    return -1;
+  }
+
+  jstring uri_str = env->NewStringUTF(std::string(uri).c_str());
+  if (!uri_str) {
+    ClearJavaException(env, "NewStringUTF(uri)");
+    return -1;
+  }
+  jstring mode_str = env->NewStringUTF(mode ? mode : "r");
+  if (!mode_str) {
+    env->DeleteLocalRef(uri_str);
+    ClearJavaException(env, "NewStringUTF(mode)");
+    return -1;
+  }
+
+  jobject pfd =
+      env->CallStaticObjectMethod(g_activity_class, g_open_content_fd, uri_str, mode_str);
+  env->DeleteLocalRef(uri_str);
+  env->DeleteLocalRef(mode_str);
+  if (env->ExceptionCheck()) {
+    ClearJavaException(env, "openContentFd");
+    return -1;
+  }
+  if (!pfd) {
+    return -1;
+  }
+
+  const jint fd = env->CallIntMethod(pfd, g_detach_fd);
+  env->DeleteLocalRef(pfd);
+  if (env->ExceptionCheck()) {
+    ClearJavaException(env, "detachFd");
+    return -1;
+  }
+  return static_cast<int>(fd);
+}
+
+bool InitializeAndroidSystemForApplicationContext() {
+  if (!g_context_ready.load(std::memory_order_acquire)) {
+    REXLOG_ERROR(
+        "android_runtime: call rex::SetAndroidApplicationContext() before starting "
+        "the runtime");
+    return false;
+  }
+  thread::AndroidInitialize();
+  memory::AndroidInitialize();
+  filesystem::AndroidInitialize();
+  return true;
+}
+
+void ShutdownAndroidSystem() {
+  filesystem::AndroidShutdown();
+  memory::AndroidShutdown();
+  thread::AndroidShutdown();
+
+  std::lock_guard<std::mutex> lock(g_context_mutex);
+  JNIEnv* env = GetThreadEnv();
+  if (env) {
+    if (g_activity) {
+      env->DeleteGlobalRef(g_activity);
+      g_activity = nullptr;
+    }
+    if (g_activity_class) {
+      env->DeleteGlobalRef(g_activity_class);
+      g_activity_class = nullptr;
+    }
+    if (g_pfd_class) {
+      env->DeleteGlobalRef(g_pfd_class);
+      g_pfd_class = nullptr;
+    }
+  }
+  g_open_content_fd = nullptr;
+  g_detach_fd = nullptr;
+  g_context_ready.store(false, std::memory_order_release);
+}
+
+}  // namespace rex
+
+namespace rex::filesystem {
+
+void AndroidInitialize() {}
+
+void AndroidShutdown() {}
+
+bool IsAndroidContentUri(const std::string_view source) {
+  return source.starts_with("content://");
+}
+
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  return rex::OpenContentUriFdJavaBridge(uri, mode);
+}
+
+}  // namespace rex::filesystem
+
+#endif  // REX_PLATFORM_ANDROID
