diff --git a/src/core/ucontext_android.cpp b/src/core/ucontext_android.cpp
new file mode 100644
index 0000000..f503eb6
--- /dev/null
+++ b/src/core/ucontext_android.cpp
@@ -0,0 +1,128 @@
+/**
+ * @file        rex/core/ucontext_android.cpp
+ * @brief       Minimal aarch64 getcontext/makecontext/setcontext/swapcontext for
+ *              Android, whose libc exposes ucontext_t but not the ucontext API.
+ *
+ * The runtime's only consumer is rex::thread::Fiber, which passes no arguments
+ * to makecontext (the trampoline reads its state from TLS) and never relies on
+ * signal-mask save/restore. Callee-saved integer registers x19-x30, sp and pc
+ * are preserved; all other registers are caller-saved by the AAPCS64 and may be
+ * clobbered across a context switch.
+ *
+ * @added      Project 1944 Android port, 2026
+ */
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID && defined(__aarch64__)
+
+#include <cstddef>
+#include <cstdint>
+#include <ucontext.h>
+
+// bionic aarch64: uc_mcontext is the kernel struct sigcontext, placed after
+// 128 bytes of signal-mask storage rounded up to its 16-byte alignment.
+static_assert(offsetof(ucontext_t, uc_flags) == 0, "bionic ucontext_t drift");
+static_assert(offsetof(ucontext_t, uc_link) == 8, "bionic ucontext_t drift");
+static_assert(offsetof(ucontext_t, uc_stack) == 16, "bionic ucontext_t drift");
+static_assert(offsetof(ucontext_t, uc_sigmask) == 40, "bionic ucontext_t drift");
+static_assert(offsetof(ucontext_t, uc_mcontext) == 176, "bionic ucontext_t drift");
+static_assert(offsetof(mcontext_t, fault_address) == 0, "bionic mcontext_t drift");
+static_assert(offsetof(mcontext_t, regs) == 8, "bionic mcontext_t drift");
+static_assert(offsetof(mcontext_t, sp) == 256, "bionic mcontext_t drift");
+static_assert(offsetof(mcontext_t, pc) == 264, "bionic mcontext_t drift");
+static_assert(offsetof(mcontext_t, pstate) == 272, "bionic mcontext_t drift");
+
+// Absolute byte offsets inside ucontext_t used by the asm blocks below.
+//   regs[0] 184, regs[19] 336, regs[30] 424, sp 432, pc 440, pstate 448.
+static_assert(offsetof(ucontext_t, uc_mcontext) + offsetof(mcontext_t, regs) +
+                      sizeof(uint64_t) * 19 ==
+                  336,
+              "unexpected aarch64 register offset");
+
+extern "C" {
+
+__attribute__((naked)) int getcontext(ucontext_t* ucp) {
+  __asm__ volatile(
+      "add     x3, x0, #184\n"
+      "stp     x19, x20, [x3]\n"
+      "stp     x21, x22, [x3, #16]\n"
+      "stp     x23, x24, [x3, #32]\n"
+      "stp     x25, x26, [x3, #48]\n"
+      "stp     x27, x28, [x3, #64]\n"
+      "stp     x29, x30, [x3, #80]\n"
+      "mov     x4, sp\n"
+      "str     x4, [x3, #248]\n"
+      "str     x30, [x3, #256]\n"
+      "str     xzr, [x0, #184]\n"
+      "str     xzr, [x3, #264]\n"
+      "mov     w0, #0\n"
+      "ret\n");
+}
+
+__attribute__((naked)) int setcontext(const ucontext_t* ucp) {
+  __asm__ volatile(
+      "add     x3, x0, #184\n"
+      "ldp     x19, x20, [x3]\n"
+      "ldp     x21, x22, [x3, #16]\n"
+      "ldp     x23, x24, [x3, #32]\n"
+      "ldp     x25, x26, [x3, #48]\n"
+      "ldp     x27, x28, [x3, #64]\n"
+      "ldp     x29, x30, [x3, #80]\n"
+      "ldr     x4, [x3, #248]\n"
+      "mov     sp, x4\n"
+      "ldr     x16, [x3, #256]\n"
+      "ldr     x17, [x3, #264]\n"
+      "msr     nzcv, x17\n"
+      "mov     x0, #0\n"
+      "br      x16\n");
+}
+
+__attribute__((naked)) int swapcontext(ucontext_t* oucp, const ucontext_t* ucp) {
+  __asm__ volatile(
+      // Save the current context into oucp.
+      "add     x2, x0, #184\n"
+      "stp     x19, x20, [x2]\n"
+      "stp     x21, x22, [x2, #16]\n"
+      "stp     x23, x24, [x2, #32]\n"
+      "stp     x25, x26, [x2, #48]\n"
+      "stp     x27, x28, [x2, #64]\n"
+      "stp     x29, x30, [x2, #80]\n"
+      "mov     x4, sp\n"
+      "str     x4, [x2, #248]\n"
+      "str     x30, [x2, #256]\n"
+      "str     xzr, [x0, #184]\n"
+      "str     xzr, [x2, #264]\n"
+      // Restore the target context from ucp.
+      "add     x3, x1, #184\n"
+      "ldp     x19, x20, [x3]\n"
+      "ldp     x21, x22, [x3, #16]\n"
+      "ldp     x23, x24, [x3, #32]\n"
+      "ldp     x25, x26, [x3, #48]\n"
+      "ldp     x27, x28, [x3, #64]\n"
+      "ldp     x29, x30, [x3, #80]\n"
+      "ldr     x4, [x3, #248]\n"
+      "mov     sp, x4\n"
+      "ldr     x16, [x3, #256]\n"
+      "ldr     x17, [x3, #264]\n"
+      "msr     nzcv, x17\n"
+      "mov     x0, #0\n"
+      "br      x16\n");
+}
+
+void makecontext(ucontext_t* ucp, void (*func)(), int argc, ...) {
+  // The fiber trampoline takes no arguments; anything else would need register
+  // setup that no current caller uses.
+  if (argc != 0) {
+    __builtin_trap();
+  }
+  ucp->uc_mcontext.regs[0] = 0;
+  ucp->uc_mcontext.pc = reinterpret_cast<uint64_t>(func);
+  ucp->uc_mcontext.sp =
+      (reinterpret_cast<uint64_t>(ucp->uc_stack.ss_sp) + ucp->uc_stack.ss_size) &
+      ~static_cast<uint64_t>(0xF);
+}
+
+}  // extern "C"
+
+#endif  // REX_PLATFORM_ANDROID && __aarch64__
