@@ -0,0 +1,54 @@
+#pragma once
+/**
+ ******************************************************************************
+ * ReXGlue : Xbox 360 Recompilation SDK
+ ******************************************************************************
+ * Android runtime glue shared between the SDK and the host application.
+ *
+ * The host application (normally SDLActivity's native entry point) must call
+ * SetAndroidApplicationContext() before starting the runtime. The values are
+ * consumed by the core filesystem, threaded and memory helpers, which cannot
+ * derive them from /proc on Android.
+ ******************************************************************************
+ * @added      Project 1944 Android port, 2026
+ */
+
+#include <cstdint>
+#include <filesystem>
+#include <string_view>
+
+#include <rex/platform.h>
+
+#if REX_PLATFORM_ANDROID
+
+namespace rex {
+
+// Value of ro.build.version.sdk, cached after the first call. Never lower
+// than __ANDROID_API__ (the minimum supported by this build).
+uint32_t GetAndroidApiLevel();
+
+// Registers the JavaVM, the foreground Activity (may be null for headless
+// starts) and ApplicationInfo.nativeLibraryDir. Only the first non-null value
+// of each piece is retained; the Activity is stored as a global JNI reference.
+void SetAndroidApplicationContext(void* java_vm, void* android_context,
+                                  const char* native_library_dir);
+
+// Directory containing the packaged native libraries (libmain.so etc.).
+// Empty until SetAndroidApplicationContext() has been called.
+const std::filesystem::path& GetAndroidNativeLibraryDir();
+
+// Opens a content:// URI through the Activity's ContentResolver and returns a
+// detached file descriptor, or -1 when the bridge is unavailable.
+int OpenContentUriFdJavaBridge(std::string_view uri, const char* mode);
+
+// Initializes the thread, memory and filesystem Android hooks. Requires
+// SetAndroidApplicationContext() to have been called first.
+bool InitializeAndroidSystemForApplicationContext();
+
+// Releases the Java global references and the Android hooks. Safe to call
+// after a failed InitializeAndroidSystemForApplicationContext().
+void ShutdownAndroidSystem();
+
+}  // namespace rex
+
+#endif  // REX_PLATFORM_ANDROID
